# Build parameters for negroni (OnePlus 10 Pro). Sourced by scripts/build.sh.
DEFCONFIG=negroni_defconfig
DTB=qcom/sm8450-oneplus-negroni.dtb
# Meta package a negroni installs; it depends on the newest
# linux-image-<release>.
META_PACKAGE=linux-image-negroni
# The part of the kernel release that marks this device's builds
# (CONFIG_LOCALVERSION in negroni_defconfig): releases look like
# 7.3.0-rc5-negroni-ci86. publish-deb.sh prunes only packages matching it.
# The device's codename, not its SoC: two devices on one SoC would prune each
# other's packages, and the kexec loader would take one's kernel for the other's.
FLAVOUR=negroni
# Kernel image_size budget for kexec (scripts/check-artifacts.sh): the loader
# places kernel, initramfs and dtb in the 74 MiB hole at 0x80d00000, so the
# kernel gets 44 MiB and the initramfs (~22 MiB) the rest.
KEXEC_KERNEL_MAX_MIB=44
