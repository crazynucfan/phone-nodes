+static const struct dev_pm_ops qcom_battmgr_pm_ops = {
+	.prepare = qcom_battmgr_prepare,
+};
+
+/*
+ * Debug knob for poking Oplus USB properties from userspace:
+ *   echo "set <prop> <value>" > usb_prop   -> BATTMGR_USB_PROPERTY_SET
+ *   echo "get <prop>" > usb_prop; cat usb_prop -> value or errno
+ */
+static ssize_t qcom_battmgr_usb_prop_write(struct file *file, const char __user *ubuf,
+					   size_t len, loff_t *ppos)
+{
+	struct qcom_battmgr *battmgr = file->private_data;
+	char buf[32];
+	unsigned int prop, value = 0;
+	int ret;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	mutex_lock(&battmgr->lock);
+	if (sscanf(buf, "set %u %u", &prop, &value) == 2) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_SET, prop, value);
+		battmgr->dbg_last = ret;
+	} else if (sscanf(buf, "get %u", &prop) == 1) {
+		WRITE_ONCE(battmgr->pending_property, prop);
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, prop, 0);
+		battmgr->dbg_last = ret ? ret : (int)battmgr->dbg_value;
+	} else {
+		ret = -EINVAL;
+	}
+	mutex_unlock(&battmgr->lock);
+	dev_info(battmgr->dev, "usb_prop: %s -> %d\n", strim(buf), ret);
+	return ret < 0 ? ret : len;
+}
+
+static ssize_t qcom_battmgr_usb_prop_read(struct file *file, char __user *ubuf,
+					  size_t len, loff_t *ppos)
+{
+	struct qcom_battmgr *battmgr = file->private_data;
+	char buf[16];
+	int n = scnprintf(buf, sizeof(buf), "%d\n", battmgr->dbg_last);
+
+	return simple_read_from_buffer(ubuf, len, ppos, buf, n);
+}
+
+static const struct file_operations qcom_battmgr_usb_prop_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = qcom_battmgr_usb_prop_read,
+	.write = qcom_battmgr_usb_prop_write,
+};
+
