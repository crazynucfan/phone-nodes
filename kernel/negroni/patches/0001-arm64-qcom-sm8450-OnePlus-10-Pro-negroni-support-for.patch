+static int synaptics_resetgpio_set(struct hw_resource *hw_res, bool on)
+{
+	if (gpio_is_valid(hw_res->reset_gpio)) {
+		TPD_DEBUG("Set the reset_gpio \n");
+		gpio_direction_output(hw_res->reset_gpio, on);
+	}
+
+	return 0;
+}
