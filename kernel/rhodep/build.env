# Build parameters for rhodep (Motorola moto g82 5G). Sourced by scripts/build.sh.
DEFCONFIG=rhodep_defconfig
DTB=qcom/sm6375-motorola-rhodep.dtb
# Meta package rhodep installs (named by device, like every phone); it depends
# on the newest linux-image-<release>.
META_PACKAGE=linux-image-rhodep
# The part of the kernel release that marks this device's builds
# (CONFIG_LOCALVERSION in rhodep_defconfig): releases look like
# 7.2.8-rhodep-ci12. publish-deb.sh prunes only packages matching it.
FLAVOUR=rhodep
# Kernel image_size budget for kexec (scripts/check-artifacts.sh). rhodep's
# memory map has not been measured yet, so this only guards against growth
# beyond the ~30 MiB the current config builds; tighten it once the
# loader's placement hole on SM6375 is known.
KEXEC_KERNEL_MAX_MIB=40
