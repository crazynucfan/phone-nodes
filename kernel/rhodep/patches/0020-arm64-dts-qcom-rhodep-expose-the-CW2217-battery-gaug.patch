From 750928094c622f76ccc5da0342aef6a0ea46d04b Mon Sep 17 00:00:00 2001
From: crazynucfan <127292955+crazynucfan@users.noreply.github.com>
Date: Fri, 9 Oct 2026 17:50:33 +0000
Subject: [PATCH 20/20] arm64: dts: qcom: rhodep: expose the CW2217 battery
 gauge

Add the CW2217 at I2C8 address 0x64 and build its read-only driver
as a module. Reference the existing battery information and use the
5 milliohm sense resistor from Motorola's captured stock device
tree. Preserve the existing charger node and its voltage/current
limits.

The gauge responds on rhodep with chip ID 0xa0, active mode, a loaded
profile, ready state 0x0c and CW2217 firmware 0x44. Raw reads
indicate about 76.6% charge, 4.11 V and 38.5 C without any gauge
configuration writes.
---
 arch/arm64/boot/dts/qcom/sm6375-motorola-rhodep.dts | 10 +++++++++-
 arch/arm64/configs/rhodep_defconfig                 |  1 +
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm6375-motorola-rhodep.dts b/arch/arm64/boot/dts/qcom/sm6375-motorola-rhodep.dts
index fdd1073ef..ca8b6dd85 100644
--- a/arch/arm64/boot/dts/qcom/sm6375-motorola-rhodep.dts
+++ b/arch/arm64/boot/dts/qcom/sm6375-motorola-rhodep.dts
@@ -140,7 +140,15 @@ &i2c8 {
 	clock-frequency = <400000>;
 	status = "okay";
 
-	/* Type-C CC logic (SGM7220, 0x47) and fuel gauge (CW2217, 0x64) */
+	/* Type-C CC logic (SGM7220, 0x47) has no driver yet. */
+
+	fuel-gauge@64 {
+		compatible = "cellwise,cw2217";
+		reg = <0x64>;
+		/* Stock rhodep DT specifies a 5 milliohm current shunt. */
+		shunt-resistor-micro-ohms = <5000>;
+		monitored-battery = <&battery>;
+	};
 
 	charger@3b {
 		compatible = "sgmicro,sgm41542";
diff --git a/arch/arm64/configs/rhodep_defconfig b/arch/arm64/configs/rhodep_defconfig
index 8de656ea9..c0e16324a 100644
--- a/arch/arm64/configs/rhodep_defconfig
+++ b/arch/arm64/configs/rhodep_defconfig
@@ -722,6 +722,7 @@ CONFIG_BATTERY_BQ27XXX=y
 CONFIG_CHARGER_BQ25890=m
 CONFIG_CHARGER_BQ25980=m
 CONFIG_CHARGER_BQ256XX=m
+CONFIG_BATTERY_CW2217=m
 CONFIG_SENSORS_ARM_SCMI=y
 CONFIG_SENSORS_GPIO_FAN=m
 CONFIG_SENSORS_JC42=m
-- 
2.47.3

