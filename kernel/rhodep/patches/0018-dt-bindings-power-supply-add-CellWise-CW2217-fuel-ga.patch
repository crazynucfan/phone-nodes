From ce4c291c110b485ce45accda170a354899140bf6 Mon Sep 17 00:00:00 2001
From: crazynucfan <127292955+crazynucfan@users.noreply.github.com>
Date: Fri, 9 Oct 2026 17:50:32 +0000
Subject: [PATCH 18/20] dt-bindings: power: supply: add CellWise CW2217 fuel
 gauge

Describe the read-only CW2217 telemetry interface, its explicit current
shunt and the existing battery information. The gauge must already be
initialized with the battery-specific profile by the bootloader.
---
 .../power/supply/cellwise,cw2217.yaml         | 55 +++++++++++++++++++
 MAINTAINERS                                   |  5 ++
 2 files changed, 60 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/cellwise,cw2217.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/cellwise,cw2217.yaml b/Documentation/devicetree/bindings/power/supply/cellwise,cw2217.yaml
new file mode 100644
index 000000000..726ee602b
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/cellwise,cw2217.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/cellwise,cw2217.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: CellWise CW2217 battery fuel gauge
+
+maintainers:
+  - crazynucfan <127292955+crazynucfan@users.noreply.github.com>
+
+description: |
+  The CW2217 reports battery state of charge, voltage, current, temperature,
+  cycle count and state of health. The bootloader must have initialized the
+  gauge with the battery-specific profile. The driver only reads telemetry;
+  it does not load a profile, reset the gauge or alter charging configuration.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: cellwise,cw2217
+
+  reg:
+    maxItems: 1
+
+  shunt-resistor-micro-ohms:
+    description: Resistance of the board's battery-current sense resistor.
+    minimum: 1000
+    maximum: 1000000
+
+  monitored-battery: true
+
+required:
+  - compatible
+  - reg
+  - shunt-resistor-micro-ohms
+  - monitored-battery
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+      #address-cells = <1>;
+      #size-cells = <0>;
+
+      fuel-gauge@64 {
+        compatible = "cellwise,cw2217";
+        reg = <0x64>;
+        shunt-resistor-micro-ohms = <5000>;
+        monitored-battery = <&battery>;
+      };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index 95cd976a0..85fe2582a 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -5964,6 +5964,11 @@ S:	Maintained
 F:	Documentation/devicetree/bindings/power/supply/cw2015_battery.yaml
 F:	drivers/power/supply/cw2015_battery.c
 
+CELLWISE CW2217 FUEL GAUGE DRIVER
