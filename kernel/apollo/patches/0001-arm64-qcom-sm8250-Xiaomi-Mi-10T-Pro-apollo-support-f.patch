+/* ----- Display subsystem ----- */
+
+&mdss {
+	status = "okay";
+};
+
+/*
+ * Single DSI, 4-lane DPHY, video-burst mode with DSC 1.1.
+ *
+ * Panel: Novatek NT36675 LCD, 1080×2400 @ 90 Hz.
+ *   - Vendor: mdss_dsi_j3s_37_02_0a_dsc_video
+ *   - Driver compatible: "xiaomi,apollo-nt36675"
+ *
+ * Supply chain (from vendor dsi_panel_pwr_supply_lab_ibb):
+ *   vddio  = PM8150 L14 (1.88 V) — panel digital I/O
+ *   vci    = PM8150L L11 (3.0 V) — panel analog supply
+ *   lab    = PM8150L LCDB positive bias (~5.5 V) — managed by LCDB driver
+ *   ibb    = PM8150L LCDB negative bias (~-5.5 V) — managed by LCDB driver
+ *
+ * The panel driver (panel-xiaomi-apollo-nt36675.c) currently manages
+ * only vddio and vci.  The LCDB lab/ibb are kept on by the LCDB
+ * regulator driver (ported from vendor).  When the panel driver is
+ * updated to control lab/ibb directly, add lab-supply and ibb-supply
+ * properties to this node.
+ *
+ * Backlight: PM8150L WLED (bl_ctrl_wled in vendor DTS).
+ */
+
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l9a_1p2>;
+	refgen-supply = <&refgen>;
+	status = "okay";
+
+	display_panel: panel@0 {
+		compatible = "xiaomi,apollo-nt36675";
+		reg = <0>;
+
+		vddio-supply = <&vreg_l14a_1p88>;
+		vci-supply = <&vreg_l11c_3p0>;
+		reset-gpios = <&tlmm 12 GPIO_ACTIVE_LOW>;
+		enable-gpios = <&tlmm 50 GPIO_ACTIVE_HIGH>;
+		backlight = <&pm8150l_wled>;
+
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&panel_default>;
+		pinctrl-1 = <&panel_sleep>;
+
+		status = "okay";
+
+		port {
+			panel_in_0: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in_0>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p88>;
+	status = "okay";
+};
+
+&pm8150l_wled {
+	status = "okay";
+	qcom,enabled-strings = <0 1 2>;
+	qcom,current-limit-microamp = <22500>;
+	qcom,ovp-millivolt = <28000>;
+	qcom,cabc;
+};
+
+&pm8150l_lcdb {
+	status = "okay";
+
+	bst {
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	ldo {
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	ncp {
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
