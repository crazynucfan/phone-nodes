+	case QRTR_TYPE_HELLO:
+		return "hello";
+	case QRTR_TYPE_BYE:
+		return "bye";
+	case QRTR_TYPE_NEW_SERVER:
+		return "new-server";
+	case QRTR_TYPE_DEL_SERVER:
+		return "del-server";
+	case QRTR_TYPE_DEL_CLIENT:
+		return "del-client";
+	case QRTR_TYPE_RESUME_TX:
+		return "resume-tx";
+	case QRTR_TYPE_EXIT:
+		return "exit";
+	case QRTR_TYPE_PING:
+		return "ping";
+	case QRTR_TYPE_NEW_LOOKUP:
+		return "new-lookup";
+	case QRTR_TYPE_DEL_LOOKUP:
+		return "del-lookup";
+	default:
+		return "unknown";
+	}
+}
