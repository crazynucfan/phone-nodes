# Build parameters for apollo (Xiaomi Mi 10T Pro). Sourced by scripts/build.sh.
DEFCONFIG=apollo_defconfig
DTB=qcom/sm8250-xiaomi-apollo.dtb
# Meta package an apollo installs; it depends on the newest
# linux-image-<release>.
META_PACKAGE=linux-image-apollo
# The part of the kernel release that marks this device's builds
# (CONFIG_LOCALVERSION in apollo_defconfig): releases look like
# 7.2.8-apollo-ci12. publish-deb.sh prunes only packages matching it.
# The device's codename, not its SoC (see negroni/build.env).
FLAVOUR=apollo
# Kernel image_size budget for kexec (scripts/check-artifacts.sh). Apollo's
# memory map has not been measured yet, so this only guards against growth
# beyond the ~54 MiB the current config builds (most drivers are built in);
# tighten it once the loader's placement hole on SM8250 is known.
KEXEC_KERNEL_MAX_MIB=64
