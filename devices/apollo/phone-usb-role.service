[Unit]
Description=Put the USB-C port in host mode
# Nothing else picks this port's role (rhodep: no driver for its Type-C logic;
# apollo: the adapter asks for no data role swap on a cold boot), so dwc3 stays
# a peripheral (the bring-up gadget) until told.
Before=network-pre.target
Wants=network-pre.target
After=systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for r in /sys/class/usb_role/*/role; do [ -e "$r" ] && echo host > "$r"; done'

[Install]
WantedBy=multi-user.target
